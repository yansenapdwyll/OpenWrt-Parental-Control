#!/usr/bin/ucode
'use strict';

import * as uci from 'uci';
import * as fs from 'fs';

let cursor = uci.cursor();
let config = cursor.get_all('parentctrl');

if (!config || !config.settings || config.settings.enabled != '1') {
    fs.unlink('/var/etc/dnsmasq-parentctrl.conf');
    exit(0);
}

const DNS_SERVERS = {
    'family': ['1.1.1.3', '1.0.0.3'],
    'safe': ['1.1.1.2', '1.0.0.2'],
    'adguard_family': ['94.140.14.15', '94.140.15.16']
};

const SAFESEARCH_MAP = [
    { domain: 'www.google.com', target: 'forcesafesearch.google.com' },
    { domain: 'google.com', target: 'forcesafesearch.google.com' },
    { domain: 'www.bing.com', target: 'strict.bing.com' },
    { domain: 'duckduckgo.com', target: 'safe.duckduckgo.com' },
    { domain: 'www.youtube.com', target: 'restrict.youtube.com' },
    { domain: 'm.youtube.com', target: 'restrict.youtube.com' },
    { domain: 'youtube.com', target: 'restrict.youtube.com' }
];

let out = [];
push(out, "# Auto-generated by OpenWrt parentctrl - DO NOT EDIT DIRECTLY\n");

if (config.settings.block_doh == '1') {
    push(out, "server=/use-application-dns.net/");
    push(out, "server=/mask.icloud.com/");
    push(out, "server=/mask-h2.icloud.com/");

    let doh_domains = [];
    for (let s in config) {
        if (config[s]['.type'] == 'doh_rules') {
            doh_domains = config[s].domain || [];
        }
    }
    for (let dom in doh_domains) {
        push(out, sprintf("nftset=/%s/4#inet#parentctrl#doh_dynamic", dom));
    }
}

for (let s in config) {
    let section = config[s];
    if (section['.type'] == 'device' && section.mac && section.profile) {
        let mac = tolower(section.mac);
        push(out, sprintf("dhcp-mac=set:tag_%s,%s", section.profile, mac));
    }
}

for (let s in config) {
    let section = config[s];
    if (section['.type'] == 'profile') {
        let prof_name = section['.name'];
        let filter = section.dns_filter;
        
        if (filter && DNS_SERVERS[filter]) {
            for (let srv in DNS_SERVERS[filter]) {
                push(out, sprintf("server=/tag:tag_%s/%s", prof_name, srv));
            }
        }

        if (section.force_safesearch == '1') {
            for (let entry in SAFESEARCH_MAP) {
                push(out, sprintf("cname=%s,%s", entry.domain, entry.target));
            }
        }
    }
}

let fd = fs.open('/var/etc/dnsmasq-parentctrl.conf', 'w');
if (fd) {
    fd.write(join("\n", out) + "\n");
    fd.close();
}
