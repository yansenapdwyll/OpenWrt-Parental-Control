config global 'settings'
    option enabled '1'
    option block_doh '1'
    option block_unknown_devices '1'
    option quarantine_notify '1'
    option notify_http_port '8088'
    option activity_threshold_kb '50'

config doh_rules 'doh_defaults'
    list domain 'cloudflare-dns.com'
    list domain 'dns.google'
    list domain 'dns.quad9.net'
    list domain 'doh.opendns.com'
    list domain 'doh.cleanbrowsing.org'
    list domain 'dns.adguard.com'
    list domain 'mask.icloud.com'
    list domain 'mask-h2.icloud.com'

config profile 'kids'
    option label 'Dzieci'
    option daily_quota_minutes '120'
    option dns_filter 'family'
    option force_safesearch '1'

config profile 'teens'
    option label 'Nastolatki'
    option daily_quota_minutes '180'
    option dns_filter 'safe'
    option force_safesearch '0'
