#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

DNSMASQ_CONF_DIR="/tmp/dnsmasq.d"
NFT_FILE="/var/run/parentctrl.nft"

start_service() {
    config_load parentctrl
    local enabled
    config_get enabled settings enabled '0'
    [ "$enabled" -eq 1 ] || return 0

    procd_open_instance "quarantine_web"
    procd_set_param command /usr/bin/ucode /usr/share/parentctrl/quarantine_page.uc
    procd_set_param respawn 3600 5 0
    procd_close_instance

    procd_open_instance "accounting_daemon"
    procd_set_param command /usr/bin/ucode /usr/share/parentctrl/parentctrl-daemon.uc
    procd_set_param respawn 3600 5 0
    procd_close_instance

    mkdir -p "$DNSMASQ_CONF_DIR"
    /usr/share/parentctrl/generate_dnsmasq.uc
    if [ -f "/var/etc/dnsmasq-parentctrl.conf" ]; then
        ln -sf /var/etc/dnsmasq-parentctrl.conf "$DNSMASQ_CONF_DIR/parentctrl.conf"
    fi

    /usr/share/parentctrl/generate_nftables.uc
    if [ -f "$NFT_FILE" ]; then
        nft delete table inet parentctrl 2>/dev/null
        nft -f "$NFT_FILE"
    fi

    /etc/init.d/dnsmasq reload
}

stop_service() {
    if [ -f "/tmp/parentctrl_stats.json" ]; then
        cp -f /tmp/parentctrl_stats.json /etc/parentctrl_history.json
    fi

    rm -f "$DNSMASQ_CONF_DIR/parentctrl.conf"
    rm -f /var/etc/dnsmasq-parentctrl.conf
    /etc/init.d/dnsmasq reload

    nft delete table inet parentctrl 2>/dev/null
    rm -f "$NFT_FILE"
}

service_triggers() {
    procd_add_reload_trigger "parentctrl"
}

reload_service() {
    stop_service
    start_service
}
